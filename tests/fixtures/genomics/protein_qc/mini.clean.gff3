NC_TEST01.1	fermdb	mRNA	365	554	.	+	.	ID=rna-YTEST02W;Parent=gene-YTEST02W;gbkey=mRNA;locus_tag=YTEST02W;product=test protein two
NC_TEST01.1	fermdb	exon	365	414	.	+	.	ID=exon-YTEST02W-1;Parent=rna-YTEST02W;gbkey=mRNA;locus_tag=YTEST02W;product=test protein two
NC_TEST01.1	fermdb	exon	461	554	.	+	.	ID=exon-YTEST02W-2;Parent=rna-YTEST02W;gbkey=mRNA;locus_tag=YTEST02W;product=test protein two
NC_TEST01.1	fermdb	CDS	365	414	.	+	0	ID=cds-NP_TEST002.1;Parent=rna-YTEST02W;Name=NP_TEST002.1;gbkey=CDS;locus_tag=YTEST02W;product=test protein two;protein_id=NP_TEST002.1
NC_TEST01.1	fermdb	CDS	461	554	.	+	1	ID=cds-NP_TEST002.1;Parent=rna-YTEST02W;Name=NP_TEST002.1;gbkey=CDS;locus_tag=YTEST02W;product=test protein two;protein_id=NP_TEST002.1
###
