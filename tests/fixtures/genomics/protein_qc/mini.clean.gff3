##gff-version 3
#!gff-spec-version 1.21
#!processor fermdb tests/fixtures/genomics/protein_qc (synthetic)
##sequence-region NC_TEST01.1 1 1892
##sequence-region NC_TEST24.1 1 300
##sequence-region NC_TEST90.1 1 243
#
# Every CDS here re-splices and translates to its own record in mini.clean.faa, so this corpus
# scores 1.000 and the gate passes it. It exists so that a test of the PASS path is a test of
# something, rather than of an empty corpus.
#
# Coverage, one shape per locus:
#
#   YTEST01W  single exon, forward, ATG start, terminal TAA
#   YTEST02W  two exons; the second declares phase 1 because the first is 50 bases long, which
#             is the case an implementation that ignores phase still gets right and one that
#             trims the WRONG segment's phase gets wrong
#   YTEST03C  minus strand -- the only shape where a splice-then-revcomp and a
#             revcomp-then-splice give the same answer only if the segment order is right
#   YTEST04W  starts TTG. Table 1 reads that as leucine; NCBI writes methionine. The
#             initiator normalisation is what makes this a pass, and it is counted.
#   Q0TEST1   on the mitochondrion, transl_table=3. Every threonine is written CTA and every
#             tryptophan TGA, so under table 1 this ORF has eight internal stops and matches
#             nothing. It is the reason this gate may not assume table 1.
#
# NC_TEST90.1 carries no gene here; it is annotated in mini.broken.gff3, where its region feature
# states no genome= and its CDS is therefore refused rather than defaulted onto table 1.
#
NC_TEST01.1	fermdb	region	1	1892	.	+	.	ID=NC_TEST01.1:1..1892;Name=NC_TEST01.1;gbkey=Src;genome=chromosome;mol_type=genomic DNA
###
NC_TEST24.1	fermdb	region	1	300	.	+	.	ID=NC_TEST24.1:1..300;Name=NC_TEST24.1;Is_circular=true;gbkey=Src;genome=mitochondrion;mol_type=genomic DNA
###
NC_TEST90.1	fermdb	region	1	243	.	+	.	ID=NC_TEST90.1:1..243;Name=NC_TEST90.1;gbkey=Src;mol_type=genomic DNA
###
NC_TEST01.1	fermdb	gene	121	267	.	+	.	ID=gene-YTEST01W;Name=YTEST01W;gbkey=Gene;gene_biotype=protein_coding;locus_tag=YTEST01W
NC_TEST01.1	fermdb	mRNA	121	267	.	+	.	ID=rna-YTEST01W;Parent=gene-YTEST01W;gbkey=mRNA;locus_tag=YTEST01W;product=test protein one
NC_TEST01.1	fermdb	exon	121	267	.	+	.	ID=exon-YTEST01W-1;Parent=rna-YTEST01W;gbkey=mRNA;locus_tag=YTEST01W;product=test protein one
NC_TEST01.1	fermdb	CDS	121	267	.	+	0	ID=cds-NP_TEST001.1;Parent=rna-YTEST01W;Name=NP_TEST001.1;gbkey=CDS;locus_tag=YTEST01W;product=test protein one;protein_id=NP_TEST001.1
###
