# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Testing and code quality
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments. NOT env/ -- that is this project's committed config tier
# (env/paths.yaml). See CONVENTIONS.md 'Paths and configuration'.
.venv/
venv/

# Project-specific. Machine-local config and secrets only -- never the curated
# repo tier (data/vocabularies, data/benchmarks, data/literature, ...), which is
# reviewed as diffs and must be tracked.
env/paths.local.yaml
env/secrets.local.env
# Transfer archives written by ops/transfer.py. The one derived artifact that lives in the tree
# on purpose: an export is carried to another machine by hand, and is easier to find beside the
# code than under a data_dir that is usually on another drive. Anchored with a leading slash so
# it means this directory and never some future src/.../exports/. Hundreds of MB per archive --
# it must never be committed, and `git add -f` on one is always a mistake.
/exports/

# Derived artifacts, if any stray into the repo. Real derived data lives under
# data_dir, outside the tree.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.parquet
*.sqlite3
*.db

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml

# OS
Thumbs.db

# Generated review pages: a snapshot of the queue, regenerate rather than commit.
review.html

node_modules/
apps/web/node_modules/
